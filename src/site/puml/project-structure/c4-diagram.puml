' @guidance:
' Create or update the C4 Component-level PlantUML diagram for the project.
'
' - If a C4 Component diagram already exists.
' - If no diagram exists, generate a new one that clearly represents all major components, their responsibilities, and interactions within the project.
' - Use PlantUML C4-PlantUML syntax and best practices for clarity and maintainability.
' - Include only relevant components from `/src/main/java` and external systems; remove or omit unnecessary details.
' - Organize the diagram for readability, avoiding complexity and clutter.
' - Add SHOW_LEGEND() at the end of the puml code.
@startuml gw-maven-plugin-components
!include <C4/C4_Component>

LAYOUT_WITH_LEGEND()

title gw-maven-plugin - C4 Component Diagram

Person(developer, "Developer", "Invokes Maven goals and supplies workflow instructions or act input.")

System_Ext(maven, "Apache Maven", "Executes goals and injects project, session, settings, and execution context.")
System_Ext(maven_reactor, "Maven Reactor", "Provides the module graph and dependency-ordered execution for per-module goals.")
System_Ext(maven_settings, "Maven Settings", "Provides provider credentials and custom configuration from settings.xml.")
System_Ext(dependency_artifacts, "Maven Dependency Artifacts", "Resolved compile- and runtime-scoped dependencies inspected for class metadata.")
System_Ext(prompter, "Maven Prompter", "Collects interactive act input when no act prompt is configured.")
System_Ext(ai_provider, "AI Provider", "External GenAI service used by the guidance and act processors.")
System_Ext(project_files, "Project Files", "Source, test, documentation, configuration, and act-definition files scanned or updated by the plugin.")

Container_Boundary(plugin, "gw-maven-plugin") {
    Component(abstract_gw_mojo, "AbstractGWMojo", "Shared Maven Mojo", "Resolves common Maven parameters and effective provider configuration, applies scan options, registers class tools, and logs usage.")
    Component(abstract_act_mojo, "AbstractActMojo", "Shared act Maven Mojo", "Resolves act prompts and definitions, configures ActProcessor, and collects interactive input when needed.")
    Component(abstract_act_per_module_mojo, "AbstractActPerModuleMojo", "Per-module act base", "Applies reactor-module eligibility, configures act processing for the current module, and suppresses recursive module traversal.")
    Component(gw_mojo, "GWMojo", "Aggregator goal: gw", "Creates GuidanceProcessor, coordinates project-wide guidance processing, resolves reactor project metadata, and configures parallel processing.")
    Component(act_mojo, "ActMojo", "Aggregator goal: act", "Delegates project-wide act execution to AbstractActMojo, including act resolution and parallel processing configuration.")
    Component(gw_per_module_mojo, "GWPerModuleMojo", "Per-module goal: gw-per-module", "Runs guidance processing for the current module; Maven invokes the goal in reactor dependency order.")
    Component(act_per_module_mojo, "ActPerModuleMojo", "Per-module goal: act-per-module", "Runs inherited act processing for the eligible current module when invoked by Maven's reactor.")
    Component(class_tools, "ClassFunctionalTools", "AI function-tool adapter", "Exposes class discovery and class-metadata functions, caching one metadata holder per Maven project base directory.")
    Component(class_info_holder, "ClassInfoHolder", "Class metadata index", "Lazily builds a project class loader and indexes visible classes, their class paths, dependency coordinates, and matching project source paths.")
}

Container_Boundary(ghostwriter, "Machai Ghostwriter / Processor Libraries") {
    Component(guidance_processor, "GuidanceProcessor", "Document processor", "Finds guidance comments, resolves project layout, and applies AI-assisted file changes.")
    Component(act_processor, "ActProcessor", "Document processor", "Resolves act configuration and prompts, then applies an act to selected documents.")
    Component(project_layout_manager, "ProjectLayoutManager", "Layout detection", "Detects the project layout used by the processors.")
    Component(project_layout, "ProjectLayout / MavenProjectLayout", "Project layout", "Provides project and module metadata to document processing.")
    Component(configurator, "PropertiesConfigurator", "Configuration", "Combines provider settings, Maven server values, configuration files, and plugin parameters.")
    Component(usage_stats, "UsageStatistics", "Telemetry utility", "Initializes and records workflow usage statistics.")
}

Rel(developer, maven, "Invokes", "mvn gw:gw / gw:act")
Rel(developer, project_files, "Maintains source, instruction, and act-definition files")
Rel(maven, gw_mojo, "Executes goal and injects context")
Rel(maven, act_mojo, "Executes goal and injects context")
Rel(maven, gw_per_module_mojo, "Executes goal for each selected module")
Rel(maven, act_per_module_mojo, "Executes goal for each selected module")
Rel(maven, maven_reactor, "Builds and coordinates modules")
Rel(gw_mojo, maven_reactor, "Uses reactor projects for layout metadata")
Rel(act_mojo, maven_reactor, "Uses reactor projects for layout metadata")
Rel(maven_reactor, gw_per_module_mojo, "Invokes in dependency order")
Rel(maven_reactor, act_per_module_mojo, "Invokes eligible goals in dependency order")
Rel(maven, dependency_artifacts, "Resolves compile and runtime dependencies")
Rel(maven_settings, abstract_gw_mojo, "Supplies server credentials")
Rel(abstract_act_mojo, prompter, "Requests act input when needed")

Rel(gw_mojo, abstract_gw_mojo, "Extends")
Rel(gw_per_module_mojo, abstract_gw_mojo, "Extends")
Rel(abstract_act_mojo, abstract_gw_mojo, "Extends")
Rel(act_mojo, abstract_act_mojo, "Extends")
Rel(abstract_act_per_module_mojo, abstract_act_mojo, "Extends")
Rel(act_per_module_mojo, abstract_act_per_module_mojo, "Extends")

Rel(abstract_gw_mojo, configurator, "Builds effective configuration")
Rel(gw_mojo, guidance_processor, "Creates and configures")
Rel(gw_per_module_mojo, guidance_processor, "Creates and configures")
Rel(abstract_act_mojo, act_processor, "Creates and configures")
Rel(guidance_processor, project_layout_manager, "Detects layout")
Rel(act_processor, project_layout_manager, "Detects layout")
Rel(project_layout_manager, project_layout, "Creates")
Rel(guidance_processor, configurator, "Uses configuration")
Rel(act_processor, configurator, "Uses configuration")
Rel(guidance_processor, project_files, "Scans and updates")
Rel(act_processor, project_files, "Scans and updates")
Rel(guidance_processor, ai_provider, "Requests AI processing")
Rel(act_processor, ai_provider, "Requests AI processing")

Rel(gw_mojo, class_tools, "Registers for project class discovery")
Rel(abstract_gw_mojo, class_tools, "Registers when Maven project context is available")
Rel(class_tools, class_info_holder, "Creates one holder per project base directory")
Rel(class_info_holder, project_files, "Inspects compiled and source classes")
Rel(class_info_holder, dependency_artifacts, "Inspects classes and coordinates")
Rel(gw_mojo, usage_stats, "Initializes and logs")
Rel(abstract_gw_mojo, usage_stats, "Logs scan usage")
Rel(abstract_act_mojo, usage_stats, "Initializes and logs act usage")

SHOW_LEGEND()
@enduml
